# =============================================================
# Legend Fade — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual Supabase values.
# NEVER commit your real .env file to Git.
# Get these values from: Supabase Dashboard → Settings → API
# =============================================================

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (safe to use on frontend — NOT the service_role key)
VITE_SUPABASE_PUBLISHABLE_KEY=
